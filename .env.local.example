# ── Obsidian AI & Shopify Studio Environment Configuration ──

# Clerk Authentication (Optional - Get your keys from https://dashboard.clerk.com)
# When provided, Obsidian automatically uses Clerk's live hosted OAuth and multi-factor auth.
# When omitted, Obsidian uses the built-in interactive Google & Email authentication system.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# App URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Gemini API Key (For AI generation)
GEMINI_API_KEY=
